<?xml version="1.0"?>

<SyntaxDefinition name = "SLang" extensions = ".slang">
	
	<Properties>
		<Property name="LineComment" value="#"/>
	</Properties>
	
	<Digits name = "Digits" bold = "false" italic = "false" color = "DarkGreen"/>

	<RuleSets>
		<RuleSet ignorecase="false">
		
			<Delimiters>&amp;&lt;&gt;~!%^*()-+=|\#/{}[]:;"' ,	.?</Delimiters>
		
		  	<Span name = "LineComment" rule = "CommentMarkerSet" bold = "false" italic = "false" color = "Gray" stopateol = "true">
			   	<Begin>#</Begin>
		  	</Span>

			<Span name = "MultilineString1" bold = "false" italic = "false" color = "Green" stopateol = "false">
				<Begin>'''</Begin>
				<End>'''</End>
			</Span>	

			<Span name = "MultilineString2" bold = "false" italic = "false" color = "Green" stopateol = "false">
				<Begin>"""</Begin>
				<End>"""</End>
			</Span>
				  	
			<Span name = "String1" bold = "false" italic = "false" color = "Green" stopateol = "true">
				<Begin>'</Begin>
				<End>'</End>
			</Span>		

			<Span name = "String2" bold = "false" italic = "false" color = "Green" stopateol = "true">
				<Begin>"</Begin>
				<End>"</End>
			</Span>

	<KeyWords name="SLangBlocks" bold="true" italic="false" color="#A626A4">
    	<Key word="Задача"/>
    	<Key word="Ввод"/>
    	<Key word="Проверка"/>
    	<Key word="Тесты"/>
    	<Key word="Вывод"/>
    	<Key word="Конец"/>
    	<Key word="КонецЗадачи"/>
    </KeyWords>
    
    <KeyWords name="SLangSystem" bold="false" italic="false" color="#4078F2">
        <Key word="ТипЦел"/><Key word="ТипВещ"/><Key word="ТипСтрока"/>
        <Key word="ТипБул"/><Key word="ТипСимвол"/>

        <Key word="Случайное"/><Key word="СлучайноеВещественное"/>
        <Key word="СлучайныйСимвол"/>
        <Key word="Случайные2"/><Key word="Случайные3"/>
        <Key word="МассивСлучайныхЦелых"/><Key word="МассивСлучайныхВещественных"/>
        <Key word="МатрицаСлучайныхЦелых"/><Key word="МатрицаСлучайныхВещественных"/>

        <Key word="ВводЦелого"/><Key word="ВводЦелогоLn"/>
        <Key word="Ввод2Целых"/><Key word="Ввод2ЦелыхLn"/>
        <Key word="Ввод3Целых"/><Key word="Ввод3ЦелыхLn"/>
        <Key word="Ввод4Целых"/><Key word="Ввод4ЦелыхLn"/>

        <Key word="ВводВещественного"/><Key word="ВводВещественногоLn"/>
        <Key word="Ввод2Вещественных"/><Key word="Ввод2ВещественныхLn"/>
        <Key word="Ввод3Вещественных"/><Key word="Ввод3ВещественныхLn"/>
        <Key word="Ввод4Вещественных"/><Key word="Ввод4ВещественныхLn"/>

        <Key word="ВводСимвола"/><Key word="ВводСимволаLn"/>
        <Key word="ВводСтроки"/><Key word="ВводСтрокиLn"/>

        <Key word="Печать"/><Key word="ПечатьСтроку"/>
        <Key word="ЦветСообщение"/>

        <Key word="ПроверитьДанные"/><Key word="ПроверитьВводТипы"/>
        <Key word="ПроверитьВводПустой"/><Key word="ПроверитьВводИсходный"/>
        <Key word="ПроверитьКоличествоВвода"/><Key word="ПроверитьКоличествоВвода2"/>
        <Key word="ПроверитьВывод"/><Key word="ПроверитьВыводБезСообщения"/>
        <Key word="ПроверитьВыводПоследующий"/><Key word="ПроверитьВыводПоследующийБезСообщения"/>
        <Key word="ПроверитьВыводПоследовательность"/>
        <Key word="ПроверитьВыводПоследовательностьБезСообщения"/>

        <Key word="целое"/><Key word="вещественное"/><Key word="символ"/><Key word="булево"/>
        <Key word="Цел"/><Key word="Вещ"/><Key word="Стр"/><Key word="Лог"/><Key word="Сим"/>
        <Key word="Цел2"/><Key word="Вещ2"/>

        <Key word="МассивЦелых"/><Key word="МассивВещественных"/>
        <Key word="МассивЛогических"/><Key word="МассивСимволов"/><Key word="МассивСтрок"/>

        <Key word="ТолькоЧисла"/><Key word="ТолькоЧислаИБулевы"/>

        <Key word="ТестЦел"/><Key word="ТестВещ"/><Key word="ТестСимвол"/><Key word="ТестБулево"/>
        <Key word="СгенерироватьТесты"/><Key word="ДобавитьТестовыеДанные"/>
    </KeyWords>

	<KeyWords name = "KeyWords" bold = "true" italic = "false" color = "#A626A4">
		<Key word = "del" />
		<Key word = "from" />
		<Key word = "import" />
		<Key word = "pass" />
		<Key word = "return" />
		<Key word = "with" />
		<Key word = "yield" />
		
		<Key word = "python" />
		<Key word = "nohtyp" />
		<Key word = "fed" />
		
	 </KeyWords> 

	<KeyWords name = "BeginEnd" bold = "true" italic = "false" color = "Black">
		<Key word = "#begin" />
		<Key word = "#end" />
	</KeyWords> 

     	<KeyWords name = "Punctuation123" bold = "true" italic = "false" color = "Orange">
		<Key word = "((" />
		<Key word = ".Where" />
	</KeyWords> 
    
    <KeyWords name="Punctuation2" bold="false" italic="false" color="Black">
	    <Key word=","/>
    	<Key word="."/>
    	<Key word=";"/>
    	<Key word="("/>
    	<Key word=")"/>
    	<Key word="["/>
    	<Key word="]"/>
    	<Key word="{"/>
    	<Key word="}"/>
    	<Key word="+"/>
    	<Key word="-"/>
    	<Key word="//"/>
    	<Key word="/"/>
    	<Key word="*"/>
    	<Key word="**"/>
    	<Key word=":"/>
    	<Key word="|"/>
    	<Key word="&lt;"/>
    	<Key word="&gt;"/>
    	<Key word="&lt;="/>
    	<Key word="&gt;="/>
    	<Key word="^"/>
    	<Key word="^="/>
    	<Key word="="/>
    	<Key word="%"/>
    	<Key word="~"/>
    	<Key word="&amp;"/>
    	<Key word="&amp;="/>
    	<Key word="&lt;&lt;="/>
    	<Key word="&gt;&gt;="/>
    	<Key word="+="/>
    	<Key word="-="/>
    	<Key word="/="/>
    	<Key word="//="/>
    	<Key word="*="/>
    	<Key word="**="/>
    	<Key word="|="/>
    	<Key word="!="/>
    	<Key word="=="/>
    	<Key word="-&gt;"/>
    </KeyWords>

    <KeyWords name="OperatorKeywords" bold="true" italic="false" color="#A626A4">
    	<Key word="or"/>
    	<Key word="and"/>
    	<Key word="not"/>
    	<Key word="as"/>
    	<Key word="is"/>
    	<Key word="in"/>
    </KeyWords>
    
    <KeyWords name="SelectionStatements" bold="true" italic="false" color="#A626A4">
    	<Key word="else"/>
    	<Key word="if"/>
    	<Key word="elif"/>
    </KeyWords>
    
    <KeyWords name="IterationStatements" bold="true" italic="false" color="#A626A4">
    	<Key word="while"/>
    	<Key word="for"/>
    </KeyWords>
					
	<KeyWords name="ExceptionHandlingStatements" bold="true" italic="false" color="#A626A4">
		<Key word="except"/>
		<Key word="finally"/>
		<Key word="try"/>
		<Key word="assert"/>
	</KeyWords>
	
	<KeyWords name="RaiseStatement" bold="true" italic="false" color="#A626A4">
		<Key word="raise"/>
	</KeyWords>
	
	<KeyWords name="JumpProcedures" bold="true" italic="false" color="#A626A4">
		<Key word="break"/>
		<Key word="continue"/>
	</KeyWords>
	
	<!-- ===== Встроенные логические/None – спокойный сине-бирюзовый ===== -->
	<KeyWords name="InternalConstant" bold="false" italic="false" color="#A626A4">
		<Key word="True"/>
		<Key word="False"/>
		<Key word="None"/>
	</KeyWords>

	<KeyWords name = "Builtins" bold="false" italic="false"  color = "#900090"> <!--python original is color="#900090"-->
		<Key word = "ArithmeticError" />
		<Key word = "AssertionError" />
		<Key word = "AttributeError" />
		<Key word = "BaseException" />
		<Key word = "BufferError" />
		<Key word = "BytesWarning" />
		<Key word = "DeprecationWarning" />
		<Key word = "EOFError" />
		<Key word = "Ellipsis" />
		<Key word = "EnvironmentError" />
		<Key word = "Exception" />
		<Key word = "False" />
		<Key word = "FloatingPointError" />
		<Key word = "FutureWarning" />
		<Key word = "GeneratorExit" />
		<Key word = "IOError" />
		<Key word = "ImportError" />
		<Key word = "ImportWarning" />
		<Key word = "IndentationError" />
		<Key word = "IndexError" />
		<Key word = "KeyError" />
		<Key word = "KeyboardInterrupt" />
		<Key word = "LookupError" />
		<Key word = "MemoryError" />
		<Key word = "NameError" />
		<Key word = "None" />
		<Key word = "NotImplemented" />
		<Key word = "NotImplementedError" />
		<Key word = "OSError" />
		<Key word = "OverflowError" />
		<Key word = "PendingDeprecationWarning" />
		<Key word = "ReferenceError" />
		<Key word = "RuntimeError" />
		<Key word = "RuntimeWarning" />
		<Key word = "StopIteration" />
		<Key word = "SyntaxError" />
		<Key word = "SyntaxWarning" />
		<Key word = "SystemError" />
		<Key word = "SystemExit" />
		<Key word = "TabError" />
		<Key word = "True" />
		<Key word = "TypeError" />
		<Key word = "UnboundLocalError" />
		<Key word = "UnicodeDecodeError" />
		<Key word = "UnicodeEncodeError" />
		<Key word = "UnicodeError" />
		<Key word = "UnicodeTranslateError" />
		<Key word = "UnicodeWarning" />
		<Key word = "UserWarning" />
		<Key word = "ValueError" />
		<Key word = "Warning" />
		<Key word = "WindowsError" />
		<Key word = "ZeroDivisionError" />
		<Key word = "abs" />
		<Key word = "all" />
		<Key word = "any" />
		<Key word = "ascii" />
		<Key word = "bin" />
		<Key word = "bool" />
		<Key word = "bytearray" />
		<Key word = "bytes" />
		<Key word = "chr" />
		<Key word = "classmethod" />
		<Key word = "compile" />
		<Key word = "complex" />
		<Key word = "copyright" />
		<Key word = "credits" />
		<Key word = "delattr" />
		<Key word = "dict" />
		<Key word = "dir" />
		<Key word = "divmod" />
		<Key word = "enumerate" />
		<Key word = "eval" />
		<Key word = "exec" />
		<Key word = "exit" />
		<Key word = "filter" />
		<Key word = "float" />
		<Key word = "format" />
		<Key word = "frozenset" />
		<Key word = "getattr" />
		<Key word = "globals" />
		<Key word = "hasattr" />
		<Key word = "hash" />
		<Key word = "help" />
		<Key word = "hex" />
		<Key word = "id" />
		<Key word = "input" />
		<Key word = "int" />
		<Key word = "isinstance" />
		<Key word = "issubclass" />
		<Key word = "iter" />
		<Key word = "len" />
		<Key word = "license" />
		<Key word = "list" />
		<Key word = "locals" />
		<Key word = "map" />
		<Key word = "max" />
		<Key word = "memoryview" />
		<Key word = "min" />
		<Key word = "next" />
		<Key word = "object" />
		<Key word = "oct" />
		<Key word = "open" />
		<Key word = "ord" />
		<Key word = "pow" />
		<Key word = "print" />
		<Key word = "property" />
		<Key word = "quit" />
		<Key word = "range" />
		<Key word = "repr" />
		<Key word = "reversed" />
		<Key word = "round" />
		<Key word = "set" />
		<Key word = "setattr" />
		<Key word = "slice" />
		<Key word = "sorted" />
		<Key word = "staticmethod" />
		<Key word = "str" />
		<Key word = "sum" />
		<Key word = "super" />
		<Key word = "tuple" />
		<Key word = "type" />
		<Key word = "vars" />
		<Key word = "zip" />
	</KeyWords>
		  
	<KeyWords name = "ReferenceTypes" bold="true" italic="false" color = "#A626A4">
		<Key word = "class" />
		<Key word = "lambda" />
		<Key word = "def" />
  	</KeyWords>
		  
	<KeyWords name = "Modifiers" bold="true" italic="false" color="#ff7700">
		<Key word = "global" />
		<Key word = "nonlocal" />
	</KeyWords>
	
	</RuleSet>
		
	<RuleSet name = "CommentMarkerSet" ignorecase = "true">
		<Delimiters>&lt;&gt;~!@%^*()-+=|\#/{}[]:;"' ,	.?</Delimiters>
		<KeyWords name = "ErrorWords" bold="true" italic="false" color="Red">
			<Key word = "TODO" />
			<Key word = "FIXME" />
	  	</KeyWords>
		<KeyWords name = "WarningWords" bold="true" italic="false" color="#EEE0E000">
			<Key word = "HACK" />
			<Key word = "UNDONE" />
	  	</KeyWords>
	</RuleSet>
		
	</RuleSets>
</SyntaxDefinition>
