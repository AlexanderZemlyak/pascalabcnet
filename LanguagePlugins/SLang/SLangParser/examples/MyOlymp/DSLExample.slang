# Задача 4 (арифметическая прогрессия)

Задача задача4
  Ввод
    ТолькоЧисла
    n = Цел()
    ПроверитьДанные(Вход = ТипЦел * (n + 1))
    a = МассивЦелых(n)
  Проверка
    результат = ""
    d: list[int] = []
    for i in range(0, n - 2):
      d.append(a[i + 1] - a[i])
    прогрессия = true
    for i in range(1, len(d) - 1):
      if d[i] != d[0]:
        прогрессия = false
        break
    if (d[0] > 0) and прогрессия:
      результат = "YES"  
    else:
      результат = "NO"
  Тесты
    TestCount = 10
    GenerateTestData = Gen
  Вывод
    ПроверитьВывод(результат)
Конец

